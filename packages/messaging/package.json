{
  "name": "@platform/messaging",
  "version": "0.1.0",
  "private": true,
  "description": "Shared messaging for the platform services: RabbitMQ connection, transactional outbox and relay, inbox, request context, logging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "health.js",
    "health.d.ts"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "test": "jest"
  },
  "dependencies": {
    "@platform/contracts": "*"
  },
  "peerDependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.1.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/terminus": "^12.1.0",
    "nestjs-pino": "^5.3.0",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "testEnvironment": "node"
  }
}
