# Copy to apps/ai-enrichment/.env for running the service outside Docker
# (npm run start:dev). In docker compose these variables are set in
# docker-compose.yml / root .env, and the environment takes precedence.

# ─── App ─────────────────────────────────────────────────────
PORT=3001
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── PostgreSQL (own database of this service) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_enrichment
DB_USERNAME=ai_enrichment
DB_PASSWORD=
DB_SSL=false

# ─── File storage (read-only: uploaded audio) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=music-files

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://platform:platform-secret@localhost:5672
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# ─── AI providers ────────────────────────────────────────────
# groq — real Whisper / LLM via Groq API; fake — fixture / deterministic answer
TRANSCRIPTION_PROVIDER=fake
LLM_PROVIDER=fake
GROQ_API_KEY=
# Artificial delays of the fake providers, ms
FAKE_TRANSCRIPTION_DELAY_MS=1000
FAKE_LLM_DELAY_MS=500
