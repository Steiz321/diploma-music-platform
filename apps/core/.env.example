# Copy to apps/core/.env for running Core outside Docker (npm run dev:core in the repo root).
# In docker compose these variables are set in docker-compose.yml / root .env,
# and the environment always takes precedence over this file.

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Basic auth for Swagger UI at /docs (leave empty to keep /docs open)
API_DOCS_USER=
API_DOCS_PASSWORD=

# ─── Secrets ─────────────────────────────────────────────────
# Must be exactly 32 characters (tweetnacl secretbox key)
ENCRYPTION_KEY=
JWT_SECRET_KEY=

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=music
DB_USERNAME=music
DB_PASSWORD=
# true for managed cloud databases; false for the local Docker postgres
DB_SSL=false
# Verify the server certificate when DB_SSL=true (set false only for self-signed certs)
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── File storage (S3 / MinIO) ───────────────────────────────
# Endpoint of S3-compatible storage; leave empty to use AWS S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=music-files
# Base URL the browser uses to fetch files: <base>/<key>
PUBLIC_FILES_BASE_URL=http://localhost:9000/music-files

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://platform:platform-secret@localhost:5672
# How long a publish waits for the broker confirm, ms
RABBITMQ_PUBLISH_TIMEOUT_MS=5000

# ─── Transactional outbox ────────────────────────────────────
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# ─── Recommendations ─────────────────────────────────────────
RECOMMENDATIONS_URL=http://localhost:3003
# a slower answer is dropped and popular songs are shown instead
RECOMMENDATIONS_TIMEOUT_MS=800
