# Copy to apps/recommendations/.env for running the service outside Docker
# (npm run start:dev). In docker compose these variables are set in
# docker-compose.yml / root .env, and the environment takes precedence.

# ─── App ─────────────────────────────────────────────────────
PORT=3003
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── PostgreSQL (own database with pgvector) ─────────────────
# the vector extension must exist in it (created by a superuser)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recommendations
DB_USERNAME=recommendations
DB_PASSWORD=
DB_SSL=false

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://platform:platform-secret@localhost:5672
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# ─── Ranking weights: content,collaborative,popularity ───────
# "For you": profile similarity, similar listeners, popularity
RECOMMENDATION_WEIGHTS=0.6,0.3,0.1
# "Similar tracks": tag similarity, co-liked, popularity
SIMILAR_WEIGHTS=0.7,0.25,0.05
