# Copy to apps/analytics/.env for running the service outside Docker
# (npm run start:dev). In docker compose these variables are set in
# docker-compose.yml / root .env, and the environment takes precedence.

# ─── App ─────────────────────────────────────────────────────
PORT=3002
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
# GET /profiles/:userId (no auth, shows listening data): true only in development
ANALYTICS_DEBUG_ENDPOINTS=false

# ─── PostgreSQL (own database of this service) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
DB_USERNAME=analytics
DB_PASSWORD=
DB_SSL=false

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://platform:platform-secret@localhost:5672
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# ─── Profiles ────────────────────────────────────────────────
# how often users with new events get their scores and profile recomputed
PROFILE_RECOMPUTE_INTERVAL_MS=60000
PROFILE_RECOMPUTE_BATCH_SIZE=100
