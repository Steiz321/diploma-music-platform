# Copy to .env (git-ignored) to override defaults of docker-compose.yml.
# Everything is optional: `docker compose up` works without this file.

# ─── AI enrichment (transcription + lyrics analysis) ─────────
# fake — recorded Groq response from apps/ai-enrichment/fixtures / fixed analysis
# groq — real Whisper transcription / gpt-oss-120b analysis, requires GROQ_API_KEY
TRANSCRIPTION_PROVIDER=fake
LLM_PROVIDER=fake
GROQ_API_KEY=
FAKE_TRANSCRIPTION_DELAY_MS=1000
FAKE_LLM_DELAY_MS=500

# ─── Core ──────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── Host ports ──────────────────────────────────────────────
CLIENT_PORT=5173
SERVER_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000
RABBITMQ_PORT=5672
AI_ENRICHMENT_PORT=3001
# RabbitMQ management UI: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Local credentials (dev only) ────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=platform-secret
AI_ENRICHMENT_DB_PASSWORD=ai-enrichment
# must be exactly 32 characters
ENCRYPTION_KEY=local-dev-encryption-key-32chars
JWT_SECRET_KEY=local-dev-jwt-secret

# Basic auth for Swagger UI at http://localhost:3000/docs (empty = open)
API_DOCS_USER=
API_DOCS_PASSWORD=
