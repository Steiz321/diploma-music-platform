# Copy to .env (git-ignored) to override defaults of docker-compose.yml.
# Everything is optional: `docker compose up` works without this file.

# ─── Transcription ───────────────────────────────────────────
# fake — recorded Groq response from apps/core/fixtures (no API calls)
# groq — real Whisper transcription, requires GROQ_API_KEY
TRANSCRIPTION_PROVIDER=fake
GROQ_API_KEY=
FAKE_TRANSCRIPTION_DELAY_MS=1000

# ─── Host ports ──────────────────────────────────────────────
CLIENT_PORT=5173
SERVER_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000

# ─── Local credentials (dev only) ────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
# must be exactly 32 characters
ENCRYPTION_KEY=local-dev-encryption-key-32chars
JWT_SECRET_KEY=local-dev-jwt-secret

# Basic auth for Swagger UI at http://localhost:3000/docs (empty = open)
API_DOCS_USER=
API_DOCS_PASSWORD=
